{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main and overlay windows",
  "windows": ["main", "overlay"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "/Library/Application Support/GrowGuard" },
        { "path": "/Library/Application Support/GrowGuard/*" },
        { "path": "/Library/Application Support/GrowGuard/**" }
      ]
    }
  ]
}
